# Defaults. Non-empty values entered in the interface take priority.
# OpenAI-compatible service root or versioned API base URL (e.g. /v1 or /api/v3).
AI_API_BASE_URL=https://api.antmoo.cc
AI_TEXT_MODEL=claude-opus-5-5
AI_IMAGE_MODEL=gpt-image-2

# Optional server-side default key. Never expose it through NEXT_PUBLIC_*.
# Leave empty to require users to provide their own key.
AI_API_KEY=

# Site address used for SEO links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
